{
  "name": "@flux-sdk/core",
  "version": "0.1.0",
  "description": "Flux mobile SDK for multi-tenant personal search and file management",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "type": "module",
  "scripts": {
    "prepare": "npm run build",
    "build": "tsc -p tsconfig.json",
    "check": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && node --test test/*.test.js"
  },
  "keywords": [
    "flux",
    "home-assistant",
    "search",
    "sdk",
    "react-native"
  ],
  "license": "MIT",
  "devDependencies": {
    "typescript": "^5.7.2"
  }
}
